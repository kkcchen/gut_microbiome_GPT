    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: trainer",
            "type": "debugpy",
            "request": "launch",
            "module": "accelerate.commands.launch",
            "cwd": "${workspaceFolder}",
            "args": [
            "trainer.py",
            "--hmc-table-path", "datasets_full/pretrain/taxonomy_table_512.npy",
            "--taxa-path", "datasets_full/pretrain/pretrain_cols.json",
            "--best-dir", "model_checkpoints/best_model",
            "--checkpoint-dir", "model_checkpoints/current_checkpoints",
            "--data-restore-dir", "model_checkpoints/data_checkpoint",
            "--experiments-path", "datasets_full/pretrain/sample_list.json",
            "--use-batch-labels",

            "--batch-size", "3",
            "--log-interval", "5",
            "--cosine-warmup-ratio-or-step", "0.1",
            "--nrows", "10",
            "--seed", "42",

            // "--start-over",

            // "--wandb-enabled",
            // "--wandb-entity", "kevinkaiwen-chen-vector",
            // "--wandb-project", "hmb_testproject",
            ]
        },
        {
          "name": "Python: encode samples",
          "type": "debugpy",
          "request": "launch",
          "module": "accelerate.commands.launch",
          "cwd": "${workspaceFolder}",
          "args": [
          "encode_samples.py",
          "--safetensors-path", "model_checkpoints/best_model/model.safetensors",
          "--output-path", "outputs/encoded_samples.npy",
          "--vocab-path", "model_checkpoints/data_checkpoint/vocab.json",
          "--vocab-metadata-path", "model_checkpoints/data_checkpoint/vocab_metadata.json",
          "--data-dict-path", "model_checkpoints/data_checkpoint/encode_datastore/data_dict.pt",
          "--npy-path", "datasets/finetune/train/finetune_data_train.npy",
          "--model-config-path", "model_checkpoints/model_config.json",
          // "--nrows", "1000"
          ]
      },
        {
            "name": "Debug preprocess_hmc.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/preprocess_hmc.py",  //  This must be the full path to the script
            "console": "integratedTerminal",
            "args": [
              "--taxonomic_table_path", "/home/kchen/microbiome/gut_microbiome_GPT/datasets/taxonomic_table.csv",
              "--pretrain_save_dir", "/home/kchen/microbiome/gut_microbiome_GPT/datasets/pretrain",
              "--finetune_save_dir", "/home/kchen/microbiome/gut_microbiome_GPT/datasets/finetune",
              "--npy_pretrain_file", "taxonomy_table_pretrain",
              "--npy_finetune_file", "taxonomy_table_finetune",
              "--sample_metadata_path", "/home/kchen/microbiome/gut_microbiome_GPT/datasets/sample_metadata.tsv",
              "--nrows", "500",
            ],
            "python": "/home/kchen/miniconda3/envs/hmbGPT/bin/python"  // optional: usually auto-detected
          }
    ]
}