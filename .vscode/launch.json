    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: trainer",
            "type": "debugpy",
            "request": "launch",
            "module": "accelerate.commands.launch",
            "cwd": "${workspaceFolder}",
            "args": [
            "trainer.py",
            "--hmc-table-path", "datasets/pretrain/taxonomy_table_512_test.npy",
            "--taxa-path", "datasets/pretrain/pretrain_cols.json",
            "--best-dir", "model_checkpoints/best_model",
            "--checkpoint-dir", "model_checkpoints/current_checkpoints",
            "--data-restore-path", "model_checkpoints/data_checkpoint/data_state.pt",

            "--batch-size", "1",
            "--log-interval", "5",
            "--cosine-warmup-ratio-or-step", "0.1",
            "--nrows", "10",
            "--seed", "42",

            // "--start-over",

            // "--wandb-enabled",
            // "--wandb-entity", "kevinkaiwen-chen-vector",
            // "--wandb-project", "hmb_testproject",
            ]
        }
    ]
}